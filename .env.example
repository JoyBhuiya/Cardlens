# Copy to .env.local for development. On the server these live in /opt/cardlens/.env (deploy/setup-vps.sh).

# Public URL of the app (magic links, cookies, trusted origin).
SITE_URL=http://localhost:3000

# Postgres. The app connects as the non-owner role cardlens_app, so row-level security applies.
DATABASE_URL=postgres://cardlens_app:CHANGE_ME@localhost:55432/cardlens
# Owner connection, used only by `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgres://cardlens:CHANGE_ME@localhost:55432/cardlens
# Optional: migrate sets the cardlens_app password to this.
APP_DB_PASSWORD=

# Better Auth session signing secret: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Comma-separated emails allowed to sign in (closed beta). Empty = anyone.
SIGNIN_ALLOWLIST=

# Salt for hashing visitor IPs in rate limits: `openssl rand -hex 16`.
IP_HASH_SALT=

# Where uploaded statements are kept until they are read (deleted after a successful parse).
STORAGE_DIR=.data/statements

# Mail. With Mailjet keys, mail is sent. Without them, MAIL_OUTBOX_DIR receives each mail as a JSON file
# (development and e2e only).
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM=
MAIL_OUTBOX_DIR=.data/outbox

# Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACT_MODEL=claude-sonnet-5-5
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5-5
ANTHROPIC_CATEGORISE_MODEL=claude-haiku-5-5

# Limits.
UPLOADS_PER_DAY=60
AI_CALLS_PER_USER_MONTH=200
AI_CALLS_PER_DAY=1000
